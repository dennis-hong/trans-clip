{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TransClip",
  "version": "0.1.21",
  "identifier": "com.transclip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TransClip",
        "width": 1200,
        "height": 280,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob: https://*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyMTMyRjZBQjM1MEUyMDkKUldRSjRsQ3phaThUMG02WmJHVXgxZjRnb2UzTjdIekFJTGJ1dlBqWnBMU25DdllkbmZIcWJkQzgK",
      "endpoints": [
        "https://github.com/dennis-hong/trans-clip/releases/latest/download/latest.json"
      ]
    }
  }
}
