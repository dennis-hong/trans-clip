<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hide from Dock, show only in menu bar -->
    <key>LSUIElement</key>
    <true/>

    <!-- Enable high resolution (Retina) support -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>

    <!-- Accessibility usage description -->
    <key>NSAccessibilityUsageDescription</key>
    <string>TransClip needs accessibility access to detect keyboard shortcuts and paste translated text.</string>

    <!-- Application category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
</dict>
</plist>
